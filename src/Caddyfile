{
    email {$ACME_EMAIL}

    servers {
        # Trust forwarded client addresses only when the immediate peer is a
        # published Cloudflare edge. Direct origin callers cannot spoof XFF.
        # Source checked 2026-09-02:
        # https://www.cloudflare.com/ips-v4 and https://www.cloudflare.com/ips-v6
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        # Cloudflare overwrites this header with the visitor address. Incoming
        # X-Forwarded-For may contain attacker-controlled values.
        client_ip_headers CF-Connecting-IP
    }
}

# CodiMD
{$CODIMD_DOMAIN} {
    reverse_proxy codimd:3000 {
        header_up X-Forwarded-For {client_ip}
    }

    # Certificate mode, driven by CADDY_TLS in .env.
    # Empty (default)  -> automatic Let's Encrypt certificates.
    # "tls internal"   -> self-signed, for local/IP testing or when an upstream
    #                     proxy terminates TLS and accepts a self-signed origin.
    {$CADDY_TLS}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

# n8n
{$N8N_DOMAIN} {
    reverse_proxy n8n:5678 {
        # WebSocket Support
        header_up X-Forwarded-For {client_ip}
        header_up X-Forwarded-Proto "https"
        header_up Host {host}
    }

    # See the CADDY_TLS note above.
    {$CADDY_TLS}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "interest-cohort=()"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

# Outline
{$OUTLINE_DOMAIN} {
    # Caddy proxies WebSocket connections natively, which Outline's realtime
    # collaboration depends on. Host and X-Forwarded-* are passed through so
    # Outline can build correct absolute URLs behind Cloudflare.
    reverse_proxy outline:3000 {
        header_up X-Forwarded-For {client_ip}
        header_up Host {host}
        header_up X-Forwarded-Proto "https"
    }

    # See the CADDY_TLS note above.
    {$CADDY_TLS}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "interest-cohort=()"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}
