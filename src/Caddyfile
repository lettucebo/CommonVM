{
    email {$ACME_EMAIL}

    servers {
        # Matches NODE_OPTIONS=--max-http-header-size=32768 on the n8n service.
        max_header_size 32KB
    }
}

# CodiMD
{$CODIMD_DOMAIN} {
    reverse_proxy codimd:3000

    # Certificate mode, driven by CADDY_TLS in .env.
    # Empty (default)  -> automatic Let's Encrypt certificates.
    # "tls internal"   -> self-signed, for local/IP testing or when an upstream
    #                     proxy terminates TLS and accepts a self-signed origin.
    {$CADDY_TLS}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}

# n8n
{$N8N_DOMAIN} {
    reverse_proxy n8n:5678 {
        # WebSocket Support
        header_up X-Forwarded-Proto "https"
        header_up Host {host}
    }

    # See the CADDY_TLS note above.
    {$CADDY_TLS}

    # Security Headers
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Permissions-Policy "interest-cohort=()"
        X-XSS-Protection "1; mode=block"
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
    }
}
