# Common
CODIMD_DOMAIN=doc.example.com
N8N_DOMAIN=n8n.example.com
OUTLINE_DOMAIN=outline.example.com

# Email address used by Caddy for ACME / Let's Encrypt registration
ACME_EMAIL=you@example.com

# Certificate mode. Leave empty for automatic Let's Encrypt certificates.
# Set to "tls internal" for self-signed certs when testing before DNS cutover,
# or when an upstream proxy terminates TLS and accepts a self-signed origin.
CADDY_TLS=

# Data Storage Path (Change this to your mounted disk path)
DATA_ROOT=/mnt/data

# CodiMD Database
CODIMD_DB_USER=codimd
CODIMD_DB_PASSWORD=change_me
CODIMD_DB_NAME=codimd

# CodiMD OAuth2 (Microsoft Entra ID Example)
CODIMD_OAUTH2_PROVIDERNAME=Entra ID
CODIMD_OAUTH2_SCOPE=User.Read
CODIMD_OAUTH2_CLIENT_ID=your_client_id
CODIMD_OAUTH2_CLIENT_SECRET=your_client_secret
CODIMD_OAUTH2_AUTHORIZATION_URL=https://login.microsoftonline.com/your_tenant_id/oauth2/v2.0/authorize
CODIMD_OAUTH2_TOKEN_URL=https://login.microsoftonline.com/your_tenant_id/oauth2/v2.0/token
CODIMD_OAUTH2_USER_PROFILE_URL=https://graph.microsoft.com/v1.0/me
CODIMD_OAUTH2_USER_PROFILE_DISPLAY_NAME_ATTR=displayName
CODIMD_OAUTH2_USER_PROFILE_USERNAME_ATTR=userPrincipalName
CODIMD_OAUTH2_USER_PROFILE_EMAIL_ATTR=mail

# CodiMD Azure Storage
CODIMD_AZURE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=your_account_name;AccountKey=your_account_key;EndpointSuffix=core.windows.net
CODIMD_AZURE_CONTAINER=contents

# n8n Database
N8N_DB_USER=n8n
N8N_DB_PASSWORD=change_me
N8N_DB_NAME=n8n

# n8n Secrets
N8N_THREADS_ACCESS_TOKEN=your_threads_access_token
N8N_EXCHANGE_API_KEY=your_exchange_api_key
# Persisted credential encryption key. Copy the value from an existing
# instance before migrating, otherwise saved credentials become unreadable.
N8N_ENCRYPTION_KEY=your_n8n_encryption_key

# Outline Database
OUTLINE_DB_USER=outline
OUTLINE_DB_PASSWORD=change_me
OUTLINE_DB_NAME=outline

# Outline Application
# Workspace name. With OIDC sign-in this is what names the team.
OUTLINE_APP_NAME=Outline
# Generate each of these with: openssl rand -hex 32
OUTLINE_SECRET_KEY=generate_with_openssl_rand_hex_32
OUTLINE_UTILS_SECRET=generate_with_openssl_rand_hex_32

# Outline authentication (Microsoft Entra ID via generic OIDC)
# The OIDC plugin is used rather than Outline's Azure plugin, because the
# latter calls Microsoft Graph /v1.0/organization and fails unless the app
# registration holds Organization.Read.All (usually admin-consent only).
# Redirect URI to register: https://<OUTLINE_DOMAIN>/auth/oidc.callback
OUTLINE_OIDC_CLIENT_ID=your_client_id
OUTLINE_OIDC_CLIENT_SECRET=your_client_secret
OUTLINE_OIDC_AUTH_URI=https://login.microsoftonline.com/your_tenant_id/oauth2/v2.0/authorize
OUTLINE_OIDC_TOKEN_URI=https://login.microsoftonline.com/your_tenant_id/oauth2/v2.0/token
OUTLINE_OIDC_USERINFO_URI=https://graph.microsoft.com/oidc/userinfo
OUTLINE_OIDC_USERNAME_CLAIM=preferred_username
OUTLINE_OIDC_DISPLAY_NAME=Entra ID
OUTLINE_OIDC_SCOPES=openid profile email

# RustDesk Self-Hosted Server
RUSTDESK_DOMAIN=your-vm.your-region.cloudapp.azure.com
RUSTDESK_ENCRYPTED_ONLY=1
